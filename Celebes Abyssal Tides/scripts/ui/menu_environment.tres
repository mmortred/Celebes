[gd_resource type="Environment" format=3]

; Main menu + lobby. Same glow as environment_preset.tres (the arena's) so the
; logo and buttons still shine, but no colour boost or bloom: those made the
; sunset sea background look neon.
[resource]
background_mode = 3
ambient_light_source = 1
tonemap_mode = 3
glow_enabled = true
glow_normalized = true
glow_intensity = 3.43
glow_strength = 0.93
glow_mix = 0.0
glow_bloom = 0.0
glow_blend_mode = 0
